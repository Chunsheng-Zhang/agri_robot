# Vite and backend on the same Jetson: these defaults work from any browser.
AGRI_BACKEND_URL=http://127.0.0.1:8000
AGRI_VIDEO_URL=http://127.0.0.1:8080
# If Vite runs on your laptop, change the targets above to the Jetson IP.
# Keep the browser API on the same origin through the proxy.
VITE_API_BASE_URL=
