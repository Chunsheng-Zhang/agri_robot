# ============================
# Python
# ============================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Environments
.venv/
venv/
ENV/
env/
.env

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# ============================
# Node.js / Frontend
# ============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# ============================
# ROS / ROS2 Workspaces
# ============================
# ROS2 build artifacts
build/
install/
devel/
log/

# ROS1 catkin
catkin_ws/
*.launch.cached

# Gazebo
.gazebo/

# ============================
# C/C++
# ============================
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.out

# ============================
# Logs and databases
# ============================
*.log
*.sql
*.sqlite
*.db

# ============================
# OS generated files
# ============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================
# Application specific
# ============================
# Data directory (if contains large/generated files)
data/*.csv
data/*.bag
data/*.db

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints/*

# Large model files
*.dat
*.bin
*.h5
*.pth
*.pt
*.onnx

# Example data and test files from libraries
**/examples/**
**/test_data/**
**/data_samples/**
**/sample_data/**

# Dlib examples and test data
**/dlib/examples/**
**/dlib/test/**

# Haar cascades and pre-trained models (can be downloaded)
haarcascade_*.xml
shape_predictor_*.dat

# Video frames and large image sequences
**/video_frames/**
**/image_sequences/**

# Generated output files
output/
results/

# ============================
# Keep these files
# ============================
# But keep data directory structure
!data/.gitkeep

# ============================
# GitHub 大文件排除（超过或接近单文件 100MB 限制）
# ============================
# ORB-SLAM 词袋模型（约 138MB），可从 ORB-SLAM 官方仓库重新获取
**/ORBvoc.txt

# TensorFlow 预训练模型图（frozen_inference_graph.pb 约 66MB）
**/*.pb

# 点云数据（resultPointCloudFile.pcd 约 37MB）
**/*.pcd
**/*.ply

# 视频文件
**/*.mp4
**/*.avi
**/*.mkv

# ROS bag 数据（体积通常很大）
**/*.bag

# ============================
# 厂商随附的第三方软件源码
# ============================
# Yahboom SDK 里的 dlib / OpenNI / g2o / YDLidar-SDK 等，可自行下载
yahboomcar_ros2_ws/software/

# ============================
# 例外：保留仿真输出结果
# ============================
# robot_sim 的路径规划 / 轨迹跟踪结果，体积小，作为示例保留
!robot_sim/output/
!robot_sim/output/**

# yahboomcar_mediapipe 人脸检测 demo 依赖的 OpenCV 级联文件
!**/haarcascade_*.xml
