[Unit]
Description=Agricultural robot ROS 2 core (idle at startup)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhang
WorkingDirectory=/home/zhang/agri_robot
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/bin/bash /home/zhang/agri_robot/scripts/start_core.bash mode:=base chassis:=none
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
