# Include these locations inside the existing site's server block.
# Proxy the bundled web_video_server's actual default port on the same origin.
location /video/ {
    proxy_pass http://127.0.0.1:8080/;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 60s;
    add_header X-Accel-Buffering no;
}

location /api/ {
    proxy_pass http://127.0.0.1:8000;
    proxy_read_timeout 5s;
}
